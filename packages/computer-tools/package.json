{
  "name": "dsh-computer-tools",
  "description": "Model-facing tools for the desktop computer-use seam: the ten computer_use tools plus the cross-call capture guidance",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5 <0.1.0",
    "dsh-computer": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-attachment-local": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-subprocess-local": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "dsh-computer": "workspace:^",
    "dsh-computer-local": "workspace:^"
  }
}
